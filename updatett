#!/usr/bin/env -S zsh -f
# Maintain this workstation's global terminal tools. No update logs are written.
set -uo pipefail
setopt NO_BG_NICE

# Kernel locks disappear on exit, including crashes. Keep the empty lock file:
# unlinking it would allow another process to lock a different inode.
zmodload zsh/system || exit 1
lock_file="${TMPDIR:-/tmp}/updatett-${UID}.lock"
[[ ! -L "$lock_file" ]] && (umask 077; : >> "$lock_file") || exit 1
if ! zsystem flock -t 0 "$lock_file" 2>/dev/null; then
    print -ru2 -- 'Another updatett instance is running, or the lock is unavailable.'
    exit 1
fi

worker_pid=''
temp_dir=''
op_target=''
typeset -a stopped_pids=()

# Freeze parents before finding children so installers cannot spawn more work
# while cancellation walks the process tree.
stop_tree() {
    local child
    kill -STOP "$1" 2>/dev/null || return 0
    stopped_pids+=("$1")
    for child in ${(f)"$(pgrep -P "$1" 2>/dev/null)"}; do
        [[ -n "$child" ]] && stop_tree "$child"
    done
}

cleanup() {
    local code=$?
    trap - INT TERM EXIT
    if [[ -n "$worker_pid" ]]; then
        stop_tree "$worker_pid"
        if (( ${#stopped_pids} )); then
            kill -TERM "${stopped_pids[@]}" 2>/dev/null || true
            kill -CONT "${stopped_pids[@]}" 2>/dev/null || true
            sleep 0.2
            kill -KILL "${stopped_pids[@]}" 2>/dev/null || true
        fi
        wait "$worker_pid" 2>/dev/null || true
    fi
    if [[ -n "$temp_dir" ]]; then
        if [[ -f "$temp_dir/installing" ]]; then
            cp -p "$temp_dir/previous-op" "$op_target" 2>/dev/null || print -ru2 -- 'Could not restore the previous 1Password CLI.'
        fi
        rm -rf -- "$temp_dir"
    fi
    return "$code"
}
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'cleanup' EXIT

# Wrangler belongs to the default nvm environment, not whichever Node happens
# to be newest. Native CLIs and uv tools take precedence over app-bundled tools.
node_ready=1
export NVM_DIR="${NVM_DIR:-${XDG_CONFIG_HOME:+$XDG_CONFIG_HOME/nvm}}"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    source "$NVM_DIR/nvm.sh" --no-use && nvm use default --silent >/dev/null 2>&1 || node_ready=0
fi
export PATH="$HOME/.local/bin:$PATH"
# Wrangler writes debug files even for --version unless explicitly disabled.
export WRANGLER_WRITE_LOGS=0

is_tty=0
[[ -t 1 ]] && is_tty=1
green='' red='' yellow='' dim='' reset=''
if (( is_tty )) && [[ -z "${NO_COLOR:-}" ]]; then
    green=$'\e[32m'; red=$'\e[31m'; yellow=$'\e[33m'
    dim=$'\e[2m'; reset=$'\e[0m'
fi
frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
row=''
failures=0

version() {
    local output
    output=$("$1" --version 2>/dev/null) || return 1
    if [[ "$output" =~ '([0-9]+\.[0-9]+\.[0-9]+([-+][[:alnum:]._-]+)?)' ]]; then
        print -r -- "$match[1]"
    else
        return 1
    fi
}

run_quiet() {
    local result=0 frame=1
    "$@" </dev/null >/dev/null 2>&1 &
    worker_pid=$!
    if (( is_tty )); then
        while kill -0 "$worker_pid" 2>/dev/null; do
            printf '\r\033[2K%s %s' "$row" "${frames[frame]}"
            frame=$((frame % ${#frames} + 1))
            sleep 0.1
        done
    fi
    wait "$worker_pid" 2>/dev/null || result=$?
    worker_pid=''
    (( ! is_tty )) || printf '\r\033[2K'
    return "$result"
}

update_tool() {
    local name=$1 binary=$2 before after code
    shift 2
    if ! command -v "$binary" >/dev/null 2>&1; then
        printf '%-18s %s✗ missing (%s)%s\n' "$name" "$red" "$binary" "$reset"
        (( failures++ ))
        return 0
    fi
    before=$(version "$binary") || before='unknown'
    row=$(printf '%-18s %s' "$name" "$before")
    if [[ "$binary" == wrangler && "$node_ready" == 0 ]]; then
        printf '%s %s✗ default Node unavailable%s\n' "$row" "$red" "$reset"
        (( failures++ ))
    elif run_quiet "$@"; then
        after=$(version "$binary") || after=''
        if [[ -z "$after" ]]; then
            printf '%s %s✗ version check failed%s\n' "$row" "$red" "$reset"
            (( failures++ ))
        elif [[ "$before" == "$after" ]]; then
            printf '%s %s✓%s %s(unchanged)%s\n' "$row" "$green" "$reset" "$dim" "$reset"
        else
            printf '%s → %s%s ✓%s\n' "$row" "$green" "$after" "$reset"
        fi
    else
        code=$?
        printf '%s %s✗ update failed (exit %s)%s\n' "$row" "$red" "$code" "$reset"
        (( failures++ ))
    fi
    return 0
}

install_1password() {
    local before channel=stable candidate expected pid attempt
    local -a packages downloads active daemons
    before=$(version "$op_target") || return 1
    [[ "$before" != *-* ]] || channel=beta
    "$op_target" update --channel "$channel" --directory "$temp_dir" || return 1
    downloads=("$temp_dir"/*(N))
    (( ${#downloads} )) || return 0
    packages=("$temp_dir"/*.pkg(N))
    (( ${#packages} == 1 )) || return 1
    pkgutil --check-signature "$packages[1]" || return 1
    pkgutil --expand-full "$packages[1]" "$temp_dir/unpacked" || return 1
    candidate="$temp_dir/unpacked/op.pkg/Payload/op"
    local requirement='anchor apple generic and identifier "com.1password.op" and certificate leaf[subject.OU] = "2BUA8C4S2C"'
    codesign --verify --strict -R="$requirement" "$candidate" || return 1
    expected=$(version "$candidate") || return 1
    [[ -f "$op_target" && ! -L "$op_target" && -w "$op_target" ]] || return 1
    # Only stop the auto-restarted cache daemon; leave active CLI work alone.
    active=(${(f)"$(pgrep -u "$UID" -x op)"})
    daemons=(${(f)"$(pgrep -u "$UID" -f '^([^[:space:]]*/)?op daemon([[:space:]]|$)')"})
    for pid in "${active[@]}"; do
        (( ${daemons[(Ie)$pid]} )) || return 1
    done
    if (( ${#daemons} )); then
        kill -TERM "${daemons[@]}" || return 1
        for attempt in {1..10}; do
            pgrep -u "$UID" -x op >/dev/null || break
            sleep 0.1
        done
    fi
    pgrep -u "$UID" -x op >/dev/null && return 1
    cp -p "$op_target" "$temp_dir/previous-op" || return 1
    # The EXIT trap restores this backup on failure or cancellation. Copying
    # over the user-owned file preserves the required /usr/local/bin location.
    : > "$temp_dir/installing"
    cp "$candidate" "$op_target" || return 1
    codesign --verify --strict -R="$requirement" "$op_target" || return 1
    [[ "$(version "$op_target")" == "$expected" ]] || return 1
    rm "$temp_dir/installing"
}

print -r -- $'\nupdatett • Global Terminal Tools\n'
update_tool uv uv env UV_NO_MODIFY_PATH=1 uv self update
update_tool Ruff ruff uv tool upgrade ruff
update_tool ty ty uv tool upgrade ty
update_tool 'Claude CLI' claude claude update
update_tool 'OpenAI Codex' codex codex update
update_tool Wrangler wrangler npm install -g wrangler@latest --allow-scripts=esbuild,workerd,fsevents --strict-allow-scripts --logs-max=0 --no-fund
op_target=$(command -v op) || op_target=''
temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/updatett-op.XXXXXXXX") || exit 1
update_tool '1Password CLI' op install_1password
print
(( ! failures )) || print -r -- "$failures tool(s) failed."
exit $(( failures > 0 ))
